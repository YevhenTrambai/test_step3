# Credentials for the TAT.ua agent CRM (crm.tat.ua/tf).
# Copy this file to ".env" and fill in your real values. NEVER commit .env.
CRM_LOGIN=your_login_here
CRM_PASSWORD=your_password_here

# Base URLs (defaults usually fine).
CRM_BASE_URL=https://crm.tat.ua
CRM_LOGIN_URL=https://crm.tat.ua/tf/login?ref=%2Ftf&lang=uk_UA

# UI language for the session.
CRM_LANG=uk_UA

# Where the cached Playwright session (cookies/tokens) is stored.
CRM_AUTH_STATE=.auth/state.json

# SQLite history database for price dynamics / monitoring.
CRM_DB_PATH=.data/history.sqlite

# Run the browser visibly (true) for first login / recon, headless (false) otherwise.
CRM_HEADFUL=false

# Be polite: minimum delay between requests to the CRM, in milliseconds.
CRM_THROTTLE_MS=1200
